<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo de tarjeta de los widgets: degradado suave + esquinas redondeadas.
  Los colores se resuelven desde values/ o values-night/, así que el mismo
  drawable sirve para tema claro y oscuro.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:startColor="@color/vq_widget_bg_start"
        android:endColor="@color/vq_widget_bg_end"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/vq_widget_stroke" />
</shape>
